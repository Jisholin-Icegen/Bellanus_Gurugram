@using Microsoft.Extensions.Options
@using Dial50_MVC_Core.Models
@inject IOptions<HospitalSettings> HospitalConfig

@{
    ViewData["Title"] = "Session Expired";
    Layout = null;

    var hospitalName = HospitalConfig.Value?.Name ?? "Hospital";
    var hospitalLogo = HospitalConfig.Value?.LogoPath ?? "images/ihh-logo.png";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - @hospitalName</title>

    <style>

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            width: 100%;
            min-height: 100vh;
            min-height: 100dvh;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
            background-color: #f1f3f7;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .page-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100vh;
            height: 100dvh;
            padding: 20px;
        }

        .session-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 40px 24px;
            width: 100%;
            max-width: 440px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            animation: slideUp 0.4s ease-out both;
        }

        .logo {
            display: flex;
            justify-content: center;
            margin-bottom: 24px;
        }

            .logo img {
                max-height: 70px;
                max-width: 100%;
                object-fit: contain;
            }

        .icon-circle {
            width: 72px;
            height: 72px;
            background: #fef2f2;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px auto;
        }

            .icon-circle span {
                color: #ef4444;
                font-size: 36px;
                font-weight: 800;
                line-height: 1;
            }

        h1 {
            margin: 0 0 12px;
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.5px;
        }

        p {
            margin: 0 0 32px;
            font-size: 15px;
            color: #64748b;
            line-height: 1.6;
        }

        .login-btn {
            display: inline-block;
            width: 100%;
            padding: 16px;
            background: #4f46e5;
            color: #ffffff;
            text-decoration: none;
            font-size: 16px;
            font-weight: 700;
            border-radius: 12px;
            transition: background 0.2s;
            text-align: center;
        }

            .login-btn:hover {
                background: #4338ca;
            }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (min-width: 768px) {
            .session-card {
                max-width: 480px;
                padding: 48px 32px;
            }

            .logo img {
                max-height: 85px;
            }

            h1 {
                font-size: 28px;
            }

            p {
                font-size: 16px;
            }

            .login-btn {
                padding: 18px;
                font-size: 17px;
            }
        }

        @@media (max-width: 360px) {
            .page-wrapper {
                padding: 12px;
            }

            .session-card {
                padding: 28px 16px;
            }

            h1 {
                font-size: 20px;
            }

            p {
                font-size: 13.5px;
            }
        }
    </style>
</head>
<body>

    <div class="page-wrapper">

        <div class="session-card">

            <div class="logo">
                <img src="@Url.Content("~/" + hospitalLogo)" alt="@hospitalName" />
            </div>

            <div class="icon-circle">
                <span>!</span>
            </div>

            <h1>Session Expired</h1>

            <p>
                This session was opened on another device. For your security, this window has been logged out.
            </p>

            <a href="@Url.Content("~/Login")" class="login-btn">Return to Login</a>

        </div>

    </div>

</body>
</html>