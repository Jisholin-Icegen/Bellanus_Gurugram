<script>
    function translateOrderSuccessItems() {
        if (!window.i18n || !i18n.dict || Object.keys(i18n.dict).length === 0) return;
        $('.ticket-item-row .item-main-name, .ordered-item-row .item-name').each(function () {
            if (!$(this).attr('data-orig')) {
                $(this).attr('data-orig', $(this).text().trim());
            }
            let originalName = $(this).attr('data-orig');
            $(this).text(i18n.t(originalName, originalName));
        });
    }

    document.addEventListener("languageChanged", translateOrderSuccessItems);
    document.addEventListener("DOMContentLoaded", function () {
        if (window.i18nReady) window.i18nReady.then(translateOrderSuccessItems);
    });

    function localizeOrderDates() {
        const localeMap = {
            en:'en-US', zh:'zh-CN', hi:'hi-IN', es:'es-ES', fr:'fr-FR',
            ar:'ar-EG', bn:'bn-BD', pt:'pt-PT', ru:'ru-RU', ur:'ur-PK', ta:'ta-IN'
        };
        const loc = localeMap[(window.i18n && i18n.current) || 'en'] || 'en-US';
        document.querySelectorAll('[data-date]').forEach(function (el) {
            const p = el.getAttribute('data-date').split('-');
            const d = new Date(+p[0], +p[1] - 1, +p[2]);
            el.textContent = d.toLocaleDateString(loc, { weekday: 'long', month: 'long', day: 'numeric' });
        });
    }
    document.addEventListener("languageChanged", localizeOrderDates);
</script>