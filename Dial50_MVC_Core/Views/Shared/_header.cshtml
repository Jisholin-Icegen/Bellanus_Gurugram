    <div class="header-flex">
        <div class="logo">
            <img src="~/images/logo.png" alt="Logo">
        </div>

        <div class="header-right-group">
@*             <partial name="_LanguageSwitcher" /> *@
            <div class="header-user-info">
                <div class="welcome" id="HospitalName"></div>
                <div class="room" id="RoomName"></div>
            </div>


            <button type="button" id="watchTutorial" title="Video Tutorial" aria-label="Video Tutorial" style="width:32px; height:32px; display:inline-flex; align-items:center; justify-content:center; padding:0; border:1px solid #c7cdd4; border-radius:50%; background:#eef1f4; color:#6b7280; cursor:pointer; -webkit-tap-highlight-color:transparent; box-shadow:0 2px 5px rgba(15,23,42,.10);">
                <svg viewBox="0 0 24 24" fill="none" style="width:19px; height:19px; display:block; overflow:visible;">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.4" />
                    <g transform="skewX(-8) translate(1.8,0)">
                        <path d="M12 10.8V16" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                        <circle cx="12" cy="7.2" r="1.6" fill="currentColor" />
                    </g>
                </svg>
            </button>


            <div class="notification-mobile-wrapper">
                <button type="button" class="notification-mobile-trigger" id="mobileNotificationTrigger" aria-label="Open notifications">
                    <img src="~/images/bell-icon.png" alt="" class="bell-icon" onerror="this.style.display='none'">
                    <span class="notification-mobile-badge" id="mobileBadgeCount">0</span>
                </button>
            </div>

            <button type="button" class="logout-btn" id="logoutButton" aria-label="Logout">
                <span class="logout-icon"></span>
            </button>
        </div>
    </div>

    <div id="logoutSheet" class="logout-sheet">
        <div class="sheet-content">
            <div class="sheet-header">Confirm Logout</div>
            <p class="sheet-text">Are you sure you want to logout?</p>
            <button type="button" class="btn-confirm" id="confirmLogoutButton">Logout</button>
            <button type="button" class="btn-cancel" id="cancelLogoutButton">Cancel</button>
        </div>
    </div>
</header>

<div id="tutorialPopup" class="tutorial-popup-overlay">
    <div class="tutorial-popup-content">
        <div class="tutorial-popup-header">
            <div class="tutorial-popup-title-area">
                <div class="tutorial-popup-icon">?</div>
                <div>
                    <h3>Video Tutorial</h3>
                    <p>A quick walkthrough of the admin console</p>
                </div>
            </div>
            <button type="button" id="closeTutorial" class="tutorial-popup-close">&#10005;</button>
        </div>

        <div class="tutorial-popup-video-area">

            <div id="tutorialLoading" class="tutorial-state-box">
                <div class="tutorial-spinner"></div>
                <p>Loading tutorial...</p>
            </div>


            <video id="tutorialVideo"
                   controls
                   preload="metadata"
                   playsinline
                   style="display:none;width:100%;">
                <source src="/videos/Tutorial_Info.mp4" type="video/mp4">
                Your browser does not support HTML5 video playback.
            </video>


            <div id="tutorialError" class="tutorial-state-box" style="display: none;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <h4>Video Unavailable</h4>
                <p>We couldn't load the tutorial video at this time.</p>
            </div>
        </div>
