    <link rel="stylesheet" href="~/css/notification-mobile.css" />

    <style>
        .app-header {
            padding: 0 0 14px !important;
        }

            .app-header .header-flex {
                padding: 8px 10px 8px 4px;
                gap: 6px;
                min-height: 56px;
            }

                .app-header .header-flex .logo img {
                    height: 34px;
                    margin-left: 14px;
                    margin-right: -11px;
                }

            .app-header .header-right-group {
                flex: 1 1 0;
                min-width: 0;
                gap: 4px;
            }

            .app-header .header-user-info {
                flex: 1 1 0;
                min-width: 0;
            }

                .app-header .header-user-info .welcome,
                .app-header .header-user-info .room {
                    max-width: 100%;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }

                .app-header .header-user-info .welcome {
                    font-size: 12px;
                }

            .app-header .lang-switcher,
            .app-header .notification-mobile-wrapper,
            .app-header .logout-btn {
                flex: 0 0 auto;
            }

            .app-header .lang-btn {
                height: 36px;
                padding: 0 6px;
                gap: 3px;
            }

            .app-header .notification-mobile-trigger {
                width: 36px;
                min-width: 36px;
                height: 36px;
                padding: 0;
            }

            .app-header .logout-btn {
                width: 36px;
                height: 36px;
            }

            .app-header .lang-menu {
                inset-inline-end: auto;
                inset-inline-start: 0;
                max-width: calc(100vw - 24px);
            }
