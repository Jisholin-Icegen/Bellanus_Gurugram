<script>
    window.logoutUrl = '@Url.Action("Logout", "PreLanding")';
    window.trackOrderUrl = '@Url.Action("OrderSuccess", "FoodDining")';

    (function () {
        function renderHeader() {
            var bc      = window.BedContext ? window.BedContext.get() : {};
            var name    = bc.patientName || '';
            var roomBed = bc.roomBed || bc.roomNumber || '';

            var elName = document.getElementById('HospitalName');
            if (elName) {
                elName.textContent = name ? ('Welcome, ' + name) : '';
            }

            var elRoom = document.getElementById('RoomName');
            if (elRoom) {
                elRoom.textContent = roomBed || '';
            }

            window.currentRoomNo = roomBed;

            var badge = document.getElementById('mobileBadgeCount');
            if (badge && badge.innerText.trim() === '0') {
                badge.classList.remove('show');
            }

            refreshMobileNotifications();
        }

        function refreshMobileNotifications() {
            if (!window.currentRoomNo) return;

            if (typeof window.getMobileUnreadCount === 'function') {
                window.getMobileUnreadCount();
            }
            if (typeof window.loadMobileNotifications === 'function') {
                window.loadMobileNotifications();
            }
            if (typeof window.getActiveCount === 'function') {
                window.getActiveCount();
            }
        }

        window.refreshHeaderFromSession = renderHeader;

        renderHeader();

        setTimeout(refreshMobileNotifications, 200);
         setInterval(function () {
            var st = document.body.getAttribute('data-state');
            if (document.hidden || st === 'connecting' || st === 'connected') return;
            refreshMobileNotifications();
        }, 5000);
    })();
</script>


<script>
    (function () {
        'use strict';

        function initializeTutorial() {
            var tutorialBtn = document.getElementById('watchTutorial');
            var tutorialPopup = document.getElementById('tutorialPopup');
            var closeTutorialBtn = document.getElementById('closeTutorial');
            var tutorialVideo = document.getElementById('tutorialVideo');
            var tutorialLoading = document.getElementById('tutorialLoading');
            var tutorialError = document.getElementById('tutorialError');

            if (!tutorialBtn || !tutorialPopup || !tutorialVideo) {
                console.error('[Tutorial] Required elements are missing.');
                return;
            }

            if (tutorialBtn.dataset.tutorialInitialized === 'true') {
                return;
            }

            tutorialBtn.dataset.tutorialInitialized = 'true';

            var videoSource = tutorialVideo.querySelector('source');
            var videoReady = false;
            var playRequested = false;

            function showLoading() {
                if (tutorialLoading) {
                    tutorialLoading.style.display = 'flex';
                }

                if (tutorialError) {
                    tutorialError.style.display = 'none';
                }

                tutorialVideo.style.display = 'none';
            }

            function showError(error) {
                console.error('[Tutorial] Video playback error:', error || tutorialVideo.error);

                if (tutorialLoading) {
                    tutorialLoading.style.display = 'none';
                }

                tutorialVideo.style.display = 'none';

                if (tutorialError) {
                    tutorialError.style.display = 'flex';
                }
            }

            function showVideo() {
                videoReady = true;

                if (tutorialLoading) {
                    tutorialLoading.style.display = 'none';
                }

                if (tutorialError) {
                    tutorialError.style.display = 'none';
                }

                tutorialVideo.style.display = 'block';
            }

            function playVideo() {
                if (!playRequested) return;

                if (tutorialVideo.readyState < 2) return;

                showVideo();

                var playPromise = tutorialVideo.play();

                if (playPromise && typeof playPromise.then === 'function') {
                    playPromise.then(function () {
                    }).catch(function (error) {
                        console.error('[Tutorial] Playback was blocked or failed:', error);

                        if (error.name !== 'AbortError') {
                            showVideo();
                        }
                    });
                }
            }

            function openTutorial() {

                tutorialPopup.classList.add('is-open');
                showLoading();

                playRequested = true;

                if (!videoReady || tutorialVideo.readyState === 0) {
                    tutorialVideo.load();
                }

                if (tutorialVideo.readyState >= 2) {
                    playVideo();
                }
            }

            function closeTutorial() {
                playRequested = false;

                tutorialVideo.pause();

                try {
                    tutorialVideo.currentTime = 0;
                } catch (e) {
                    console.warn('[Tutorial] Could not reset video position.', e);
                }

                tutorialPopup.classList.remove('is-open');
            }

            tutorialBtn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                openTutorial();
            });

            if (closeTutorialBtn) {
                closeTutorialBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    closeTutorial();
                });
            }

            tutorialPopup.addEventListener('click', function (e) {
                if (e.target === tutorialPopup) {
                    closeTutorial();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && tutorialPopup.classList.contains('is-open')) {
                    closeTutorial();
                }
            });

            tutorialVideo.addEventListener('loadeddata', function () {
                videoReady = true;
                playVideo();
            });

            tutorialVideo.addEventListener('canplay', function () {
                videoReady = true;
                playVideo();
            });

            tutorialVideo.addEventListener('playing', function () {
                showVideo();
            });

            tutorialVideo.addEventListener('error', function () {
                showError(tutorialVideo.error);
            });

            if (videoSource) {
            }

        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeTutorial, { once: true });
        } else {
            initializeTutorial();
        }
    })();
</script>


