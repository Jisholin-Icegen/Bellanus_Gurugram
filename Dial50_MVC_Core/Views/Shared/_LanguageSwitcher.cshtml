@* Language dropdown. Put it in your header: <partial name="_LanguageSwitcher" /> *@

<style>
    .lang-switcher {
        position: relative;
        display: inline-block;
    }

    .lang-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        font: 600 14px/1 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: #1f2937;
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        cursor: pointer;
        transition: background .15s, border-color .15s, box-shadow .15s;
        -webkit-tap-highlight-color: transparent;
    }

        .lang-btn:hover {
            background: #f3f4f6;
            border-color: #9ca3af;
        }

        .lang-btn:focus-visible {
            outline: none;
            box-shadow: 0 0 0 3px rgba(79, 140, 255, .35);
            border-color: #4f8cff;
        }

        .lang-btn svg {
            width: 16px;
            height: 16px;
            flex: 0 0 16px;
            display: block;
        }

        .lang-btn .chev {
            width: 12px;
            height: 12px;
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

    .lang-switcher.open .lang-btn .chev {
        transform: rotate(180deg);
    }

    #langBtnCode {
        font-weight: 800;
        letter-spacing: .02em;
        min-width: 1.6em;
        text-align: center;
    }

    .lang-menu {
        list-style: none;
        margin: 0;
        padding: 6px;
        background: #ffffff !important;
        border: 1px solid #e5e7eb !important;
        border-radius: 12px !important;
        box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.15), 0 8px 15px -6px rgba(0, 0, 0, 0.1) !important;
        font: 600 14px/1.3 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        position: fixed !important;
        z-index: 2147483647 !important;
        display: none;
        opacity: 0;
        transform: translateY(-8px) scale(0.97);
        transform-origin: top center;
        transition: opacity 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        width: auto !important;
        min-width: 125px !important;
        max-width: 160px !important;
    }

    .lang-switcher.open .lang-menu {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    .lang-option {
        display: flex !important;
        align-items: center !important;
        padding: 8px 12px !important;
        margin: 1px 0 !important;
        border-radius: 7px !important;
        cursor: pointer !important;
        color: #111827 !important;
        font-weight: 700 !important;
        font-size: 13.5px !important;
        background: #ffffff !important;
        transition: background-color 0.15s ease !important;
        user-select: none;
        white-space: nowrap !important;
    }

        .lang-option:hover {
            background-color: #f3f4f6 !important;
        }

        .lang-option:focus-visible {
            outline: none !important;
            background-color: #f3f4f6 !important;
            box-shadow: inset 0 0 0 2px #4f8cff !important;
        }

        .lang-option[aria-selected="true"] {
            background-color: #eff6ff !important;
            color: #1d4ed8 !important;
        }

    #i18n-loader {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(156, 163, 175, 0.6) !important;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 2147483647;
    }

    .i18n-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid rgba(255, 255, 255, 0.3);
        border-top-color: #4f8cff;
        border-radius: 50%;
        animation: i18nSpin 0.8s linear infinite;
    }

    @@keyframes i18nSpin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="lang-switcher notranslate" id="langSwitcher" translate="no">
    <button class="lang-btn" id="langBtn" type="button" aria-expanded="false" aria-haspopup="listbox">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20" /></svg>
        <span id="langBtnCode">EN</span>
        <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
    </button>
    <ul class="lang-menu" id="langMenu" role="listbox"></ul>
</div>

<div id="i18n-loader" class="notranslate" translate="no">
    <div class="i18n-spinner"></div>
</div>

<script src="~/js/language-switcher.js" asp-append-version="true"></script>