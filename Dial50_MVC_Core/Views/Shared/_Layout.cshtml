    @await RenderSectionAsync("Scripts", required: false)


    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (!window.PushClient) return;

            var roomBed = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Convert.ToString(ViewBag.RoomBed ?? "")))';
            var bedInfo = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Convert.ToString(ViewBag.bedInfo ?? "")))';

            if (window.BedContext && typeof BedContext.get === "function") {
                var ctx = BedContext.get() || {};
                if (!roomBed) roomBed = ctx.roomBed || "";
                if (!bedInfo) bedInfo = ctx.bedInfo || "";
            }

            if (!bedInfo) {
                try { bedInfo = sessionStorage.getItem("bedInfo") || ""; } catch (e) {}
            }

            if (!bedInfo) {
                bedInfo = new URLSearchParams(window.location.search).get("BedInfo") || "";
            }

            if (bedInfo) {
                try { sessionStorage.setItem("bedInfo", bedInfo); } catch (e) {}
            }

            if (roomBed && bedInfo) {
                PushClient.init(roomBed);
            }
        });
    </script>
</body>
</html>