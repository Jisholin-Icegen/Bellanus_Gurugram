<script>
    var curpage = window.location.pathname.split("/").filter(Boolean).pop();

    var urlParams = new URLSearchParams(window.location.search);
    var urlBedInfo = urlParams.get('BedInfo');

    if (urlBedInfo) {
        sessionStorage.setItem('encryptedBedInfo', urlBedInfo);
    }

    function GoToCurrentRequest() {
        BedContext.go('CurrentRequests/Index', { FromLoc: 'Logisitics' });
    }

    document.addEventListener("DOMContentLoaded", function () {
        var buttons = document.querySelectorAll(".navBtn");

        buttons.forEach(function (button) {
            if (button.dataset.page === curpage)
                button.classList.add("active");

            button.addEventListener("click", function () {
                var page = this.getAttribute("data-page");
                if (!page) return;

                var target = (page === 'FoodDining') ? 'FoodDining/FoodDining' : page;
                BedContext.go(target);
            });
        });
    });

    window.__taskTypesRequest = fetch('/Logisitics/GetTaskTypes', { cache: 'no-store' })
        .then(function (r) { return r.json(); })
        .catch(function () { return []; });
</script>

<script src="~/js/layout_DailyCare.js" defer></script>
<script src="~/js/Logistics.js" defer></script>

<script>
    (function () {
        function stopEvent(e) {
            if (!e) return;
            e.preventDefault();
            e.stopPropagation();
            if (typeof e.stopImmediatePropagation === "function") e.stopImmediatePropagation();
        }

        function isGuestPassCard(el) {
            if (!el) return false;
            if (el.dataset && el.dataset.action === "guest-pass") return true;
            var titleEl = el.querySelector ? el.querySelector(".service-title") : null;
            if (!titleEl) return false;
            var text = (titleEl.textContent || "").trim().toUpperCase();
            return text === "PREPARE GUEST PASS";
        }

        function pad(n) { return n < 10 ? "0" + n : "" + n; }

        function nowTimeLabel() {
            var d = new Date(), h = d.getHours(), m = d.getMinutes(), ampm = h >= 12 ? "PM" : "AM";
            h = h % 12; if (h === 0) h = 12;
            return h + ":" + pad(m) + " " + ampm;
        }

        function validUntilLabel() {
            var d = new Date();
            d.setHours(d.getHours() + 4);
            var days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"], h = d.getHours(), m = d.getMinutes(), ampm = h >= 12 ? "PM" : "AM";
            h = h % 12; if (h === 0) h = 12;
            return days[d.getDay()] + ", " + h + ":" + pad(m) + " " + ampm;
        }

        function randomPassCode() {
            var chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789", code = "";
            for (var i = 0; i < 4; i++) code += chars.charAt(Math.floor(Math.random() * chars.length));
            return "GP-" + code;
        }

        window.openGuestPassModal = function () {
            var modal = document.getElementById("guestPassModal");
            if (!modal) return;
            modal.classList.add("is-open");
            document.body.style.overflow = "hidden";
            setTimeout(function () {
                var g = document.getElementById("guestName");
                if (g) g.focus();
            }, 150);
        };

        window.closeGuestPassModal = function () {
            var modal = document.getElementById("guestPassModal");
            if (!modal) return;
            modal.classList.remove("is-open");
            document.body.style.overflow = "";
            var name = document.getElementById("guestName"), phone = document.getElementById("guestPhone"), container = document.getElementById("guestMembersContainer");
            if (name) name.value = "";
            if (phone) phone.value = "";
            if (container) container.innerHTML = "";
        };

        window.addGuestMember = function () {
            var container = document.getElementById("guestMembersContainer");
            if (!container) return;
            var index = container.children.length + 1, id = "guestMember_" + index;
            var div = document.createElement("div");
            div.className = "guest-member-input";
            div.id = id;
            div.innerHTML = '<input type="text" placeholder="Member name" autocomplete="off">' +
                '<button type="button" class="remove-member-btn" onclick="removeGuestMember(\'' + id + '\')">×</button>';
            container.appendChild(div);
        };

        window.removeGuestMember = function (id) {
            var m = document.getElementById(id);
            if (m) m.remove();
        };

        window.requestGuestPass = function () {
            var name = document.getElementById("guestName"), phone = document.getElementById("guestPhone");
            if (!name || name.value.trim() === "") { if (name) name.focus(); return; }
            if (!phone || phone.value.trim() === "") { if (phone) phone.focus(); return; }

            var guestName = name.value.trim(), guestPhone = phone.value.trim(), passCode = randomPassCode();
            var visitingName = sessionStorage.getItem("PatientName") || "Sarah Jenkins";
            var roomLabel = sessionStorage.getItem("RoomBed") || sessionStorage.getItem("RoomNumber") || sessionStorage.getItem("BedNumber") || "Room 402";

            if (roomLabel && roomLabel.indexOf("Room") !== 0 && roomLabel.indexOf("Bed") !== 0 && roomLabel.indexOf("Ward") !== 0) {
                roomLabel = "Room " + roomLabel;
            }

            document.getElementById("sentGuestName").textContent = guestName;
            document.getElementById("sentPhone").textContent = guestPhone;
            document.getElementById("sentBannerPhone").textContent = guestPhone;
            document.getElementById("sentPassCode").textContent = passCode;
            document.getElementById("sentVisitingName").textContent = visitingName;
            document.getElementById("sentRoom").textContent = roomLabel;
            document.getElementById("sentTimeIn").textContent = nowTimeLabel();
            document.getElementById("sentValidUntil").textContent = validUntilLabel();

            window.closeGuestPassModal();

            var sentModal = document.getElementById("guestPassSentModal");
            if (sentModal) {
                sentModal.classList.add("is-open");
                document.body.style.overflow = "hidden";
            }
        };

        window.closeGuestPassSentModal = function () {
            var sentModal = document.getElementById("guestPassSentModal");
            if (!sentModal) return;
            sentModal.classList.remove("is-open");
            document.body.style.overflow = "";
        };

        document.addEventListener("click", function (e) {
            var card = e.target.closest(".service-card");
            if (!card) return;
            if (!isGuestPassCard(card)) return;
            stopEvent(e);
            window.openGuestPassModal();
        }, true);

        document.addEventListener("keydown", function (e) {
            if (e.key !== "Escape") return;
            var modal = document.getElementById("guestPassModal"), sentModal = document.getElementById("guestPassSentModal");
            if (modal && modal.classList.contains("is-open")) { window.closeGuestPassModal(); return; }
            if (sentModal && sentModal.classList.contains("is-open")) window.closeGuestPassSentModal();
        });
    })();
</script>
