@using Microsoft.Extensions.Options
@using Dial50_MVC_Core.Models
@inject IOptions<HospitalSettings> HospitalConfig

@{
    ViewData["Title"] = "Logged Out";
    Layout = null;

    var hospitalName = HospitalConfig.Value?.Name ?? "Hospital";
    var hospitalLogo = HospitalConfig.Value?.LogoPath ?? "images/ihh-logo.png";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - @hospitalName</title>

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            width: 100%;
            min-height: 100vh;
            min-height: 100dvh;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, 'Helvetica Neue', sans-serif;
            background-color: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            color: #1e293b;
        }

        .page-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100vh;
            height: 100dvh;
            padding: 24px;
        }

        .session-card {
            background: #ffffff;
            border-radius: 20px;
            padding: 48px 32px;
            width: 100%;
            max-width: 440px;
            text-align: center;
            box-shadow: 0 12px 35px rgba(15, 23, 42, 0.05), 0 2px 8px rgba(15, 23, 42, 0.02);
            animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
            border: 1px solid #eef2f6;
        }

        .logo {
            display: flex;
            justify-content: center;
            margin-bottom: 32px;
        }

            .logo img {
                max-height: 65px;
                max-width: 100%;
                object-fit: contain;
            }

        .icon-circle {
            width: 80px;
            height: 80px;
            background: #f0fdf4;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px auto;
            border: 1px solid #bbf7d0;
        }

            .icon-circle svg {
                width: 36px;
                height: 36px;
                stroke: #10b981;
                stroke-width: 2.5;
                fill: none;
            }

        h1 {
            margin: 0 0 16px;
            font-size: 26px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.5px;
        }

        p {
            margin: 0 0 36px;
            font-size: 15px;
            color: #64748b;
            line-height: 1.6;
            padding: 0 8px;
        }

        .login-btn {
            display: inline-block;
            width: 100%;
            padding: 16px;
            background: #4f46e5;
            color: #ffffff;
            text-decoration: none;
            font-size: 16px;
            font-weight: 700;
            border-radius: 12px;
            transition: all 0.2s ease;
            text-align: center;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
        }

            .login-btn:hover {
                background: #4338ca;
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(79, 70, 229, 0.3);
            }

            .login-btn:active {
                transform: translateY(1px);
                box-shadow: 0 2px 8px rgba(79, 70, 229, 0.2);
            }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(24px) scale(0.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@media (min-width: 768px) {
            .session-card {
                max-width: 480px;
                padding: 56px 40px;
            }

            .logo img {
                max-height: 75px;
            }

            h1 {
                font-size: 30px;
            }

            p {
                font-size: 16px;
            }

            .login-btn {
                padding: 18px;
                font-size: 17px;
            }
        }

        @@media (max-width: 360px) {
            .page-wrapper {
                padding: 16px;
            }

            .session-card {
                padding: 32px 20px;
            }

            h1 {
                font-size: 22px;
            }

            p {
                font-size: 14px;
            }
        }
    </style>
</head>
<body>

    <div class="page-wrapper">

        <div class="session-card">

            <div class="logo">
                <img src="@Url.Content("~/" + hospitalLogo)" alt="@hospitalName" />
            </div>

            <div class="icon-circle">
                <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>

            <h1>Logged Out Successfully</h1>

            <p>
                You have been safely logged out of your account. Thank you for using our services.
            </p>

            <a href="@Url.Content("~/Login")" class="login-btn">Log In Again</a>

        </div>

    </div>

</body>
</html>