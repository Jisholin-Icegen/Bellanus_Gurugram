@model List<BedInfo>
@{
    var firstBed = Model?.FirstOrDefault();

    var region = ViewBag.Region as string;
    var isInvalid = ViewBag.IsInvalid as bool? ?? false;

    var bedInfoEncrypt = (ViewBag.bedInfoEncrypt ?? "").ToString();
    var hospitalName = (ViewBag.HospitalName ?? "IHH Healthcare").ToString();
    var hospitalLogo = (ViewBag.HospitalLogo ?? "images/ihh-logo.png").ToString();

    ViewData["Title"] = isInvalid
        ? "Invalid QR Code - " + hospitalName
        : "Welcome - " + hospitalName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/PreLanding.css">

    <style>
        html {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow-x: hidden !important;
            box-sizing: border-box !important;
            background-color: #f1f3f7 !important;
        }

        body {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            min-height: 100vh !important;
            min-height: 100dvh !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow-x: hidden !important;
            overflow-y: auto !important;
            background-color: #f1f3f7 !important;
            display: flex !important;
            flex-direction: column !important;
            justify-content: center !important;
            align-items: center !important;
            box-sizing: border-box !important;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box !important;
        }

        img {
            max-width: 100% !important;
        }

        .app-wrapper {
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            min-height: 100vh !important;
            min-height: 100dvh !important;
            margin: 0 !important;
            padding: 20px !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            box-sizing: border-box !important;
        }

        .welcome-container {
            width: 100% !important;
            max-width: 480px !important;
            min-width: 0 !important;
            margin: 0 auto !important;
            padding: 40px 20px !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            background: #ffffff !important;
            border-radius: 24px !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05) !important;
            overflow: hidden !important;
            word-wrap: break-word !important;
            overflow-wrap: break-word !important;
            box-sizing: border-box !important;
        }

        .welcome-card {
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            background: transparent !important;
            box-shadow: none !important;
            box-sizing: border-box !important;
        }

        .logo {
            width: 100% !important;
            max-width: 100% !important;
            min-width: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
            overflow: hidden !important;
            box-sizing: border-box !important;
        }

            .logo img {
                display: block !important;
                width: auto !important;
                max-width: 100% !important;
                height: auto !important;
                max-height: 80px !important;
                margin: 0 auto 24px auto !important;
                object-fit: contain !important;
            }

        .welcome-message,
        .welcome-submessage,
        .patient-info,
        .patient-details,
        .patient-name,
        .bed-number {
            max-width: 100% !important;
            min-width: 0 !important;
            box-sizing: border-box !important;
            overflow-wrap: anywhere !important;
            word-break: break-word !important;
        }

        .patient-info {
            width: 100% !important;
        }

        .patient-details {
            width: 100% !important;
            text-align: center !important;
        }

        .patient-name {
            max-width: 100% !important;
        }

        .bed-number {
            max-width: 100% !important;
        }

        #preLandingConfig {
            display: none !important;
        }

        #pageLoader,
        .page-loader,
        .loader-overlay {
            max-width: 100vw !important;
        }

        body > div[style*="position:fixed"] {
            max-width: calc(100vw - 20px) !important;
        }

            body > div[style*="position:fixed"] > * {
                max-width: 100% !important;
            }

        .error-container {
            width: 100% !important;
            max-width: 480px !important;
            min-width: 0 !important;
            margin: 0 auto !important;
            padding: 40px 20px !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            box-sizing: border-box !important;
            overflow: hidden !important;
        }

            .error-container .logo {
                width: 100% !important;
            }

            .error-container .card {
                width: 100% !important;
                max-width: 100% !important;
                min-width: 0 !important;
                box-sizing: border-box !important;
                overflow-wrap: anywhere !important;
                word-break: break-word !important;
            }

            .error-container h2,
            .error-container p {
                max-width: 100% !important;
                overflow-wrap: anywhere !important;
                word-break: break-word !important;
            }


        /* MOBILE */

        @@media (max-width: 767px) {

            html,
            body {
                width: 100% !important;
                min-width: 0 !important;
                max-width: 100% !important;
            }

            body {
                min-height: 100dvh !important;
                justify-content: flex-start !important;
            }

            .app-wrapper {
                width: 100% !important;
                min-width: 0 !important;
                min-height: 100dvh !important;
                padding: max(12px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) max(12px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left)) !important;
                justify-content: center !important;
            }

            .welcome-container {
                width: 100% !important;
                max-width: 480px !important;
                min-width: 0 !important;
                padding: 32px 18px !important;
                border-radius: 24px !important;
            }

            .welcome-card {
                width: 100% !important;
                max-width: 100% !important;
                min-width: 0 !important;
            }

            .logo {
                width: 100% !important;
                max-width: 100% !important;
            }

                .logo img {
                    max-width: 90% !important;
                    max-height: 80px !important;
                    margin-bottom: 20px !important;
                }

            .error-container {
                width: 100% !important;
                max-width: 480px !important;
                padding: 32px 18px !important;
            }

                .error-container .card {
                    width: 100% !important;
                }

            body > div[style*="position:fixed"] {
                top: max(8px, env(safe-area-inset-top)) !important;
                inset-inline-end: max(8px, env(safe-area-inset-right)) !important;
                max-width: calc(100vw - 16px) !important;
            }
        }


        /* SMALL MOBILE */

        @@media (max-width: 480px) {

            .app-wrapper {
                padding: 12px !important;
            }

            .welcome-container {
                width: 100% !important;
                max-width: 100% !important;
                padding: 28px 16px !important;
                border-radius: 22px !important;
            }

            .welcome-card {
                width: 100% !important;
            }

            .logo img {
                max-width: 85% !important;
                max-height: 70px !important;
                margin-bottom: 18px !important;
            }

            .error-container {
                width: 100% !important;
                max-width: 100% !important;
                padding: 28px 16px !important;
            }

                .error-container .logo img {
                    max-width: 85% !important;
                    max-height: 70px !important;
                }
        }


        /* VERY SMALL MOBILE */

        @@media (max-width: 360px) {

            .app-wrapper {
                padding: 10px !important;
            }

            .welcome-container {
                width: 100% !important;
                max-width: 100% !important;
                padding: 24px 14px !important;
                border-radius: 20px !important;
            }

            .logo img {
                max-width: 82% !important;
                max-height: 65px !important;
                margin-bottom: 16px !important;
            }

            .error-container {
                padding: 24px 14px !important;
            }

                .error-container .logo img {
                    max-width: 82% !important;
                    max-height: 65px !important;
                }
        }


        /* TABLET */

        @@media (min-width: 768px) and (max-width: 1024px) {

            html,
            body {
                width: 100% !important;
                min-width: 0 !important;
                max-width: 100% !important;
            }

            .app-wrapper {
                width: 100% !important;
                min-width: 0 !important;
                padding: 24px !important;
            }

            .welcome-container {
                width: 100% !important;
                max-width: 480px !important;
                min-width: 0 !important;
                padding: 40px 20px !important;
            }

            .welcome-card {
                width: 100% !important;
                max-width: 100% !important;
            }

            .logo img {
                max-width: 100% !important;
                max-height: 80px !important;
            }

            .error-container {
                width: 100% !important;
                max-width: 480px !important;
            }
        }


        /* TABLET LANDSCAPE */

        @@media (min-width: 768px) and (max-width: 1024px) and (orientation: landscape) {

            .app-wrapper {
                padding: 20px !important;
            }

            .welcome-container {
                max-width: 480px !important;
                padding: 32px 20px !important;
            }
        }


        /* MOBILE LANDSCAPE */

        @@media (orientation: landscape) and (max-height: 600px) {

            html,
            body {
                min-height: 100dvh !important;
            }

            body {
                justify-content: flex-start !important;
                overflow-y: auto !important;
            }

            .app-wrapper {
                min-height: 100dvh !important;
                padding-top: 16px !important;
                padding-bottom: 16px !important;
                justify-content: flex-start !important;
            }

            .welcome-container {
                padding-top: 24px !important;
                padding-bottom: 24px !important;
            }

            .error-container {
                padding-top: 24px !important;
                padding-bottom: 24px !important;
            }

            .logo img {
                max-height: 60px !important;
                margin-bottom: 16px !important;
            }
        }


        /* EXTREMELY SHORT SCREENS */

        @@media (max-height: 450px) {

            body {
                justify-content: flex-start !important;
                overflow-y: auto !important;
            }

            .app-wrapper {
                min-height: 100dvh !important;
                padding-top: 10px !important;
                padding-bottom: 10px !important;
            }

            .welcome-container {
                padding-top: 20px !important;
                padding-bottom: 20px !important;
            }

            .error-container {
                padding-top: 20px !important;
                padding-bottom: 20px !important;
            }

            .logo img {
                max-height: 55px !important;
                margin-bottom: 12px !important;
            }
        }
    </style>

    <script src="~/js/language-switcher.js" asp-append-version="true"></script>
</head>

<body>

    <div style="position:fixed;top:10px;inset-inline-end:10px;z-index:2000">
        <partial name="_LanguageSwitcher" />
    </div>

    <div class="app-wrapper">

        <partial name="_PageLoader" />

        @if (isInvalid || firstBed == null || string.IsNullOrEmpty(firstBed.PatientName))
        {
            <div class="error-container" id="divError" align="center">

                <div class="logo">
                    <img src="@Url.Content("~/" + hospitalLogo)"
                         alt="@hospitalName" />
                </div>

                <div class="card">

                    <div class="icon-circle">
                        <span>!</span>
                    </div>

                    <h2>Invalid QR Code</h2>

                    <p>
                        The QR code is invalid or the associated patient details
                        are unavailable. Please verify the code or contact hospital
                        support for further assistance.
                    </p>

                </div>

            </div>
        }
        else
        {
            <div class="welcome-container"
                 id="divWelocme"
                 align="center">

                <div class="logo">
                    <img src="@Url.Content("~/" + hospitalLogo)"
                         alt="@hospitalName" />
                </div>

                <div class="welcome-card">

                    <div class="welcome-message">
                        Welcome to your stay
                    </div>

                    <div class="welcome-submessage">
                        We’re here to make your stay comfortable and convenient.
                        You can easily access
                        <strong>
                            Talk to AI, Daily Care, Room Comfort, Food &amp; Beverage,
                        </strong>
                        and <strong>Logistics</strong> — all from one place.
                    </div>

                    <div class="patient-info">

                        <div class="loading-ring"></div>

                        <div class="patient-details">

                            <div class="patient-name">
                                @firstBed.PatientName
                            </div>

                            <div class="bed-number">
                                Bed No: <span>@firstBed.BedNumber</span>
                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>


    <div id="preLandingConfig"
         hidden
         data-home-url="@Url.Action("Index", "Home")"
         data-is-invalid="@(isInvalid ? "true" : "false")"
         data-bed-info="@bedInfoEncrypt"
         data-region="@(region ?? "")">
    </div>


    <script>
        (function () {

            var cfgEl = document.getElementById("preLandingConfig");

            if (!cfgEl) return;

            var HOME_URL = cfgEl.dataset.homeUrl || "/Home";
            var IS_INVALID = cfgEl.dataset.isInvalid === "true";
            var BED_INFO = cfgEl.dataset.bedInfo || "";
            var REGION = cfgEl.dataset.region || "";

            try {
                var q = new URLSearchParams(window.location.search);
                var rg = q.get("region") || REGION || "";

                if (rg) {
                    sessionStorage.setItem("region", rg);
                }
            }
            catch (e) {
            }


            document.addEventListener("DOMContentLoaded", function () {

                var REDIRECT_DELAY_MS = 1500;
                var CLOSE_DELAY_MS = 20000;

                if (IS_INVALID || !BED_INFO) {

                    setTimeout(function () {
                        window.close();
                    }, CLOSE_DELAY_MS);

                    return;
                }


                try {
                    sessionStorage.setItem("bedInfo", BED_INFO);
                }
                catch (e) {
                }


                var regionLocal = "";

                try {
                    regionLocal =
                        sessionStorage.getItem("region") || "";
                }
                catch (e) {
                }


                var url =
                    HOME_URL +
                    "?BedInfo=" +
                    BED_INFO;


                if (regionLocal) {
                    url +=
                        "&region=" +
                        encodeURIComponent(regionLocal);
                }


                setTimeout(function () {

                    window.location.replace(url);

                }, REDIRECT_DELAY_MS);

            });

        })();
    </script>


    <script src="~/js/PreLoading.js"></script>

</body>
</html>
