@model BedInfo
@{
    ViewData["Title"] = ":: Appointments & Tests ::";
}
<link href="~/css/appointments.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/DailyCare.css">
<style>
    .icon-box {
        width: 50px;
        height: 50px;
    }

    .card {
        padding: 16px;
    }
</style>
<div class="app-wrapper">

    <partial name="_header"></partial>
    <div class="mobile-header">
        <button class="back-btn" onclick="goBackMDC();">←</button>
        <div class="title"><h1>Appointments & Tests</h1></div>
    </div>
    <div class="subtitle">
        Your scheduled medical appointments and diagnostic tests.
    </div>

    <div id="appointmentsContainer" class="content" style="display: flow;"></div>
    <partial name="_footer"></partial>
    <script>


        document.addEventListener("DOMContentLoaded", function () {


        var hospitalName = '@Model?.PatientName';
        var bedNumber = '@Model?.BedNumber';


        $("#HospitalName").html("Welcome " + hospitalName);
        $("#RoomName").html(bedNumber);

        });
        function goBackMDC() {

             var bedInfoEncrypt = '@ViewBag.bedInfoEncrypt';

            var url = '@Url.Action("Index", "MyDailyCare")';
             window.location.href = url + '?BedInfo='+encodeURIComponent( bedInfoEncrypt);


        }
    </script>
</div>

<script src="~/js/Appointment.js"></script>
<script src="~/js/layout_DailyCare.js"></script>