@model List<TaskRequests>
@{
    ViewData["Title"] = ":: Current Requests ::";
}

<link href="~/css/CurrentRequests.css" rel="stylesheet" />
<div class="overlay">
    <div class="popup request-card">
        <span class="close-btn" onclick="goBackToParent();">×</span>
        <div class="popup-content">
            <div class="avatar-wrapper">
                <div class="avatar">
                    <img id="staffImage" src="~/images/porter/default.png">
                </div>
            </div>

            <div class="request-id">
                Request Id: <span class="bold" id="requestId"></span>
            </div>

            <div class="section-text">
                Support staff <span class="bold" id="staffName"></span> <span class="porterstatus_pending"> will be </span> assigned <span class="porterstatus_pending"> soon </span>.<br>
                Task Name: <span class="bold" id="taskName"></span>
            </div>

            <div class="status-card">
                <div class="status-item">
                    <div class="icon-circle">⏱</div>
                    <h4>ETA</h4>
                    <p id="eta"></p>
                </div>

                <div class="divider"></div>

                <div class="status-item">
                    <div class="icon-circle">📍</div>
                    <h4>STATUS</h4>
                    <p id="statusText" style="color:#17b6a4;"></p>
                </div>
            </div>

            <button class="track-btn" id="track-btn">Track Status</button>
        </div>

        <div class="popup-footer">
            <div class="nav-btn" id="prevBtn">‹ Previous</div>
            <div class="pagination" id="pagination"></div>
            <div class="nav-btn" id="nextBtn">Next ›</div>
        </div>

    </div>


    <script type="text/javascript">

        // const requests =  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));


        var bedInfoEncrypt = '@ViewBag.bedInfoEncrypt',ParentLocationDeCrypt = '@ViewBag.ParentLocationDeCrypt';


            function getCurrentRequests(){
            return @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
            }

            function goBackToParent(){
                     var url = ParentLocationDeCrypt;
                     window.location.href = url + '?BedInfo='+encodeURIComponent( bedInfoEncrypt) ;
           }

            function TrackRequest(RequestID) {

             var bedInfoEncrypt = '@ViewBag.bedInfoEncrypt';

             window.location.href = 'Tracking?BedInfo='+encodeURIComponent( bedInfoEncrypt) + '&RequestID='+ RequestID;


        }
    </script>
</div>

<script src="~/js/CurrentRequests.js"></script>